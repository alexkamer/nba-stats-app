// NBA Stats Webapp — Prisma schema
// Mirrors SPEC.md §6. Every ESPN-sourced model keeps `espnId` (unique) so
// ingestion upserts by espn id are idempotent and traceable to source.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum SeasonType {
  PRESEASON
  REGULAR
  POSTSEASON
}

enum GameStatus {
  SCHEDULED
  LIVE
  FINAL
}

// Mapped from ESPN's free-text injury report `status` field at ingest time
// (see player-availability-tracking capability) — not ESPN's own enum,
// since ESPN doesn't document one. An unrecognized status maps to
// QUESTIONABLE, never AVAILABLE, so a mapping gap can't silently hide a
// real absence.
enum AvailabilityStatus {
  OUT
  DOUBTFUL
  QUESTIONABLE
  PROBABLE
  AVAILABLE
}

// ---------- Reference / slow-changing ----------

model Conference {
  id        Int        @id @default(autoincrement())
  espnId    String     @unique @map("espn_id")
  name      String
  divisions Division[]

  @@map("conference")
}

model Division {
  id           Int        @id @default(autoincrement())
  espnId       String     @unique @map("espn_id")
  name         String
  conferenceId Int        @map("conference_id")
  conference   Conference @relation(fields: [conferenceId], references: [id])
  teams        Team[]

  @@map("division")
}

model Venue {
  id       Int     @id @default(autoincrement())
  espnId   String  @unique @map("espn_id")
  name     String
  city     String?
  state    String?
  capacity Int?
  teams    Team[]
  games    Game[]

  @@map("venue")
}

model Position {
  id           Int      @id @default(autoincrement())
  espnId       String   @unique @map("espn_id")
  name         String
  abbreviation String
  players      Player[]

  @@map("position")
}

model Team {
  id             Int       @id @default(autoincrement())
  espnId         String    @unique @map("espn_id")
  name           String
  location       String
  displayName    String    @map("display_name")
  abbreviation   String
  color          String?
  alternateColor String?   @map("alternate_color")
  logoUrl        String?   @map("logo_url")
  divisionId     Int?      @map("division_id")
  division       Division? @relation(fields: [divisionId], references: [id])
  venueId        Int?      @map("venue_id")
  venue          Venue?    @relation(fields: [venueId], references: [id])

  players           Player[]
  seasonIdentities  TeamSeasonIdentity[]
  homeGames         Game[]               @relation("HomeTeam")
  awayGames         Game[]               @relation("AwayTeam")
  playsAsTeam       Play[]
  teamGameStats     TeamGameStat[]
  teamSeasonStats   TeamSeasonStat[]
  playerSeasonStats PlayerSeasonStat[]
  standings         Standing[]
  playerGameStats   PlayerGameStat[]
  nbaCupStandings   NbaCupStanding[]
  coverRecords      TeamCoverRecord[]
  gamePerformances  TeamGamePerformance[]

  @@map("team")
}

// A team's espnId is stable across relocation/rename (e.g. Seattle
// SuperSonics -> Oklahoma City Thunder is one franchise id, confirmed
// during the historical-backfill research). This table captures the
// identity ESPN reported for that franchise in a given season year, so
// historical games/pages can render the era-accurate name/colors/logo
// instead of always showing the current branding.
model TeamSeasonIdentity {
  id             Int     @id @default(autoincrement())
  teamId         Int     @map("team_id")
  team           Team    @relation(fields: [teamId], references: [id])
  year           Int
  name           String
  location       String
  displayName    String  @map("display_name")
  abbreviation   String
  color          String?
  alternateColor String? @map("alternate_color")
  logoUrl        String? @map("logo_url")

  @@unique([teamId, year])
  @@map("team_season_identity")
}

model Player {
  id            Int       @id @default(autoincrement())
  espnId        String    @unique @map("espn_id")
  fullName      String    @map("full_name")
  displayName   String    @map("display_name")
  headshotUrl   String?   @map("headshot_url")
  jersey        String?
  positionId    Int?      @map("position_id")
  position      Position? @relation(fields: [positionId], references: [id])
  currentTeamId Int?      @map("current_team_id")
  currentTeam   Team?     @relation(fields: [currentTeamId], references: [id])
  heightIn      Int?      @map("height_in")
  weightLb      Int?      @map("weight_lb")
  birthDate     DateTime? @map("birth_date")
  birthPlace    String?   @map("birth_place")
  college       String?
  draftYear     Int?      @map("draft_year")
  draftRound    Int?      @map("draft_round")
  draftPick     Int?      @map("draft_pick")
  active        Boolean   @default(true)

  playerGameStats   PlayerGameStat[]
  playerSeasonStats PlayerSeasonStat[]

  propOdds        PlayerPropOdds[]
  propProjections PlayerPropProjection[]
  availabilities  PlayerAvailability[]
  dailyStatLeaderEntries DailyStatLeaderEntry[]
  dailyBestBets   DailyBestBet[]

  @@map("player")
}

model Season {
  id   Int        @id @default(autoincrement())
  year Int
  type SeasonType

  games             Game[]
  teamSeasonStats   TeamSeasonStat[]
  playerSeasonStats PlayerSeasonStat[]
  standings         Standing[]
  nbaCupStandings   NbaCupStanding[]
  coverRecords      TeamCoverRecord[]
  gamePerformances  TeamGamePerformance[]

  @@unique([year, type])
  @@map("season")
}

// ---------- Game / event data ----------

model Game {
  id         Int        @id @default(autoincrement())
  espnId     String     @unique @map("espn_id")
  seasonId   Int        @map("season_id")
  season     Season     @relation(fields: [seasonId], references: [id])
  seasonType SeasonType @map("season_type")
  date       DateTime
  status     GameStatus @default(FINAL)
  period     Int?
  clock      String?
  homeTeamId Int        @map("home_team_id")
  homeTeam   Team       @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId Int        @map("away_team_id")
  awayTeam   Team       @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeScore  Int?       @map("home_score")
  awayScore  Int?       @map("away_score")
  venueId    Int?       @map("venue_id")
  venue      Venue?     @relation(fields: [venueId], references: [id])
  attendance Int?

  plays           Play[]
  teamGameStats   TeamGameStat[]
  playerGameStats PlayerGameStat[]
  odds            Odds?

  playerPropOdds        PlayerPropOdds[]
  predictorSnapshot     PredictorSnapshot?
  gameProjection        GameProjection?
  playerPropProjections PlayerPropProjection[]
  playerAvailabilities  PlayerAvailability[]
  teamPerformances      TeamGamePerformance[]
  dailyBestBets         DailyBestBet[]

  @@map("game")
}

// Best-effort, informational only (no betting UI) — re-added after
// confirming ESPN's `summary` call (already fetched for every game) still
// carries the pre-game line via `pickcenter`, even on completed games.
// Coverage is sparse and era-dependent (confirmed via direct probing: solid
// ~2015-Jan 2023, mostly empty Feb 2023 through most of 2025-26 — likely an
// ESPN odds-partner transition — present again for the current season), so
// most games simply won't have a row here. Only the highest-priority
// provider ESPN lists is kept, not every sportsbook.
model Odds {
  id                Int    @id @default(autoincrement())
  gameId            Int    @unique @map("game_id")
  game              Game   @relation(fields: [gameId], references: [id])
  provider          String
  spread            Float? // home-team-relative, matching ESPN's own convention
  overUnder         Float?  @map("over_under")
  homeMoneyline     Int?   @map("home_moneyline")
  awayMoneyline     Int?   @map("away_moneyline")
  favoriteTeamId    Int?   @map("favorite_team_id")
  // Opening line, captured the first time a scheduled game's odds are seen
  // (see betting-odds-ingest capability) — `spread`/`overUnder`/moneylines
  // above hold the current line, refreshed up to tip-off.
  openSpread        Float? @map("open_spread")
  openOverUnder     Float? @map("open_over_under")
  openHomeMoneyline Int?   @map("open_home_moneyline")
  openAwayMoneyline Int?   @map("open_away_moneyline")
  // Per-side vig for the spread/total lines above — American odds, same
  // convention as home/awayMoneyline (e.g. -110). Only ever populated via
  // the core API's single-provider resource (mapCoreOdds); the retrospective
  // pickcenter-based path (mapOdds) doesn't carry these fields.
  homeSpreadOdds    Int?   @map("home_spread_odds")
  awaySpreadOdds    Int?   @map("away_spread_odds")
  overOdds          Int?   @map("over_odds")
  underOdds         Int?   @map("under_odds")
  // Stamped once this game's result has been folded into both teams'
  // `TeamCoverRecord` aggregate (team-cover-record-tracking capability) —
  // mirrors the grading-timestamp convention `GameProjection.gradedAt` and
  // `PredictorSnapshot.gradedAt` already use, so re-running the aggregate
  // script is idempotent instead of double-counting a game.
  coverRecordComputedAt DateTime? @map("cover_record_computed_at")

  @@map("odds")
}

// ---------- Betting insights (forward-looking) ----------

// Stat types the betting-insights page surfaces player props for — a
// deliberate subset of the much larger set ESPN's propBets endpoint returns
// (quarter/half markets, milestones, etc. are not ingested; see design.md
// "Prop odds volume" risk).
enum PropStatType {
  POINTS
  REBOUNDS
  ASSISTS
  THREE_POINTERS_MADE
  STEALS
  BLOCKS
  POINTS_ASSISTS
  POINTS_REBOUNDS
  REBOUNDS_ASSISTS
  POINTS_REBOUNDS_ASSISTS
  DOUBLE_DOUBLE
  TRIPLE_DOUBLE
}

enum PropSide {
  OVER
  UNDER
}

// Player prop market line for a scheduled game, one row per side (ESPN
// returns the over and under for a given stat/line as separate entries).
model PlayerPropOdds {
  id            Int          @id @default(autoincrement())
  gameId        Int          @map("game_id")
  game          Game         @relation(fields: [gameId], references: [id])
  playerId      Int          @map("player_id")
  player        Player       @relation(fields: [playerId], references: [id])
  provider      String
  statType      PropStatType @map("stat_type")
  side          PropSide
  line          Float?
  odds          Int?
  openLine      Float?       @map("open_line")
  openOdds      Int?         @map("open_odds")
  lastUpdated   DateTime     @map("last_updated")

  projection PlayerPropProjection?

  @@unique([gameId, playerId, statType, side])
  @@map("player_prop_odds")
}

// One-time snapshot of ESPN's own pre-game predictor (projected score /
// win probability) for a scheduled game. ESPN does not retain this once a
// game goes final, so it is captured proactively and never refreshed.
model PredictorSnapshot {
  id         Int      @id @default(autoincrement())
  gameId     Int      @unique @map("game_id")
  game       Game     @relation(fields: [gameId], references: [id])
  // ESPN's `predictor` only exposes win probability (confusingly labeled
  // `gameProjection` by ESPN itself) — no projected score/margin exists in
  // this field, confirmed by direct probing.
  homeWinPct Float    @map("home_win_pct")
  awayWinPct Float    @map("away_win_pct")
  capturedAt DateTime @map("captured_at")

  // Graded once the game is FINAL (prediction-accuracy-tracking capability).
  // Null until then.
  gradedCorrect     Boolean? @map("graded_correct")
  gradedMarginError Float?   @map("graded_margin_error")
  gradedAt          DateTime? @map("graded_at")

  @@map("predictor_snapshot")
}

// Pre-game availability status per (game, player), sourced from ESPN's
// injury report (see player-availability-tracking capability). Unlike
// PredictorSnapshot's write-once pattern, this is refreshed on every sync
// run while the game is still SCHEDULED — an injury status genuinely
// changes pre-tip — and stops being touched once the game is no longer
// SCHEDULED, so projections/grading never see a post-tip-off change.
model PlayerAvailability {
  id         Int                @id @default(autoincrement())
  gameId     Int                @map("game_id")
  game       Game               @relation(fields: [gameId], references: [id])
  playerId   Int                @map("player_id")
  player     Player             @relation(fields: [playerId], references: [id])
  status     AvailabilityStatus
  comment    String?
  capturedAt DateTime           @map("captured_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  @@unique([gameId, playerId])
  @@map("player_availability")
}

// Our own game-level projection, computed and frozen before tip-off (see
// design.md "Projections are persisted rows, computed once, frozen
// pre-game") so grading never reflects hindsight.
model GameProjection {
  id                  Int      @id @default(autoincrement())
  gameId              Int      @unique @map("game_id")
  game                Game     @relation(fields: [gameId], references: [id])
  projectedHomeScore  Float    @map("projected_home_score")
  projectedAwayScore  Float    @map("projected_away_score")
  projectedMargin     Float    @map("projected_margin") // home-team-relative
  // Recent-game variance for margin/total, and whether our pick clears the
  // market by enough relative to that variance to be worth calling out
  // (see lib/projections/confidence.ts) — same idea as a player prop's
  // `bettable`, applied to the spread and the total independently. `false`
  // when there's no market line yet to compare against.
  marginStdev     Float?   @map("margin_stdev")
  totalStdev      Float?   @map("total_stdev")
  spreadBettable  Boolean  @default(false) @map("spread_bettable")
  totalBettable   Boolean  @default(false) @map("total_bettable")
  // The market's home-relative margin/total at the moment this projection
  // was frozen (derived from `Odds.spread`/`overUnder` then, not read live
  // later) — against-the-spread/total grading must compare our pick to the
  // same line it was actually made against, not whatever the market has
  // moved to since.
  marketMarginAtPick Float? @map("market_margin_at_pick")
  marketTotalAtPick  Float? @map("market_total_at_pick")
  method              String
  createdAt           DateTime @default(now()) @map("created_at")

  // Graded once the game is FINAL. Null until then. `gradedCorrect` is the
  // straight-up winner pick; `gradedSpreadCorrect`/`gradedTotalCorrect` are
  // the against-the-spread/total picks shown on the page's "Our pick" row
  // — a different bet, graded separately (see lib/accuracy/grade-game.ts).
  gradedCorrect        Boolean?  @map("graded_correct")
  gradedMarginError    Float?    @map("graded_margin_error")
  gradedSpreadCorrect  Boolean?  @map("graded_spread_correct")
  gradedTotalCorrect   Boolean?  @map("graded_total_correct")
  gradedAt             DateTime? @map("graded_at")

  @@map("game_projection")
}

// Our own player-prop projection, one per (game, player, stat), frozen at
// creation time the same way as GameProjection.
model PlayerPropProjection {
  id               Int          @id @default(autoincrement())
  gameId           Int          @map("game_id")
  game             Game         @relation(fields: [gameId], references: [id])
  playerId         Int          @map("player_id")
  player           Player       @relation(fields: [playerId], references: [id])
  statType         PropStatType @map("stat_type")
  propOddsId       Int?         @unique @map("prop_odds_id")
  propOdds         PlayerPropOdds? @relation(fields: [propOddsId], references: [id])
  // The line at the moment this projection was frozen — copied off `propOdds.line`
  // at creation time rather than read live through the relation, since that row
  // keeps getting overwritten by every sync until tip-off (and grading must never
  // compare against a line that moved after the pick was made).
  line             Float?
  projectedValue   Float        @map("projected_value")
  // Recent-game standard deviation for this stat, frozen alongside the
  // projection — used to size the pick's edge against the player's own
  // typical game-to-game variance (see `bettable`).
  stdev            Float?
  // Whether the edge between `projectedValue` and `line` is large relative
  // to `stdev` (see lib/projections/confidence.ts) — the subset of picks
  // worth surfacing by default, instead of every tracked prop regardless of
  // how close the call actually is.
  bettable         Boolean      @default(false)
  method           String
  createdAt        DateTime     @default(now()) @map("created_at")

  // Graded once the game is FINAL. Null until then.
  gradedCorrect      Boolean?  @map("graded_correct")
  gradedActualValue  Float?    @map("graded_actual_value")
  gradedAt           DateTime? @map("graded_at")

  @@unique([gameId, playerId, statType])
  @@map("player_prop_projection")
}

// Locks in a calendar day's "Best Bets" selection the first time anyone
// requests that day's live picks (see src/lib/daily-best-bets.ts) — every
// later request for the same `date` reads this same frozen list instead of
// re-ranking against whatever's changed since (a newly-ingested prop with
// a bigger edge, a player ruled out promoting the next-best candidate),
// so a pick already shown to an early visitor can't be silently swapped
// out later the same day. `edgeRatioAtSelection` is the edge the pick had
// when it was locked in, kept for display — grading itself is always read
// live off the referenced PlayerPropProjection's own gradedCorrect, never
// duplicated here.
model DailyBestBet {
  id                   Int          @id @default(autoincrement())
  date                 String       // local YYYY-MM-DD this selection is frozen for
  rank                 Int          // 1-based order within that day's selection
  gameId               Int          @map("game_id")
  game                 Game         @relation(fields: [gameId], references: [id])
  playerId             Int          @map("player_id")
  player               Player       @relation(fields: [playerId], references: [id])
  statType             PropStatType @map("stat_type")
  edgeRatioAtSelection Float        @map("edge_ratio_at_selection")
  createdAt            DateTime     @default(now()) @map("created_at")

  @@unique([date, playerId, statType])
  @@map("daily_best_bet")
}

model Play {
  id             Int     @id @default(autoincrement())
  espnId         String  @unique @map("espn_id")
  gameId         Int     @map("game_id")
  game           Game    @relation(fields: [gameId], references: [id])
  sequenceNumber Int     @map("sequence_number")
  period         Int?
  clock          String?
  description    String?
  teamId         Int?    @map("team_id")
  team           Team?   @relation(fields: [teamId], references: [id])
  homeScore      Int?    @map("home_score")
  awayScore      Int?    @map("away_score")
  scoringPlay    Boolean @default(false) @map("scoring_play")

  @@index([gameId, sequenceNumber])
  @@map("play")
}

model TeamGameStat {
  id                Int  @id @default(autoincrement())
  gameId            Int  @map("game_id")
  game              Game @relation(fields: [gameId], references: [id])
  teamId            Int  @map("team_id")
  team              Team @relation(fields: [teamId], references: [id])
  points            Int?
  rebounds          Int?
  offensiveRebounds Int? @map("offensive_rebounds")
  defensiveRebounds Int? @map("defensive_rebounds")
  assists           Int?
  steals            Int?
  blocks            Int?
  turnovers         Int?
  fouls             Int?
  fgMade            Int? @map("fg_made")
  fgAtt             Int? @map("fg_att")
  threeMade         Int? @map("three_made")
  threeAtt          Int? @map("three_att")
  ftMade            Int? @map("ft_made")
  ftAtt             Int? @map("ft_att")

  @@unique([gameId, teamId])
  @@map("team_game_stat")
}

model PlayerGameStat {
  id                Int     @id @default(autoincrement())
  gameId            Int     @map("game_id")
  game              Game    @relation(fields: [gameId], references: [id])
  playerId          Int     @map("player_id")
  player            Player  @relation(fields: [playerId], references: [id])
  teamId            Int     @map("team_id")
  team              Team    @relation(fields: [teamId], references: [id])
  starter           Boolean?
  minutes           Int?
  points            Int?
  rebounds          Int?
  offensiveRebounds Int?    @map("offensive_rebounds")
  defensiveRebounds Int?    @map("defensive_rebounds")
  assists           Int?
  steals            Int?
  blocks            Int?
  turnovers         Int?
  fouls             Int?
  fgMade            Int?    @map("fg_made")
  fgAtt             Int?    @map("fg_att")
  threeMade         Int?    @map("three_made")
  threeAtt          Int?    @map("three_att")
  ftMade            Int?    @map("ft_made")
  ftAtt             Int?    @map("ft_att")
  plusMinus         Int?    @map("plus_minus")

  @@unique([gameId, playerId])
  @@map("player_game_stat")
}

// Per calendar date, the player(s) with the highest combined
// points+rebounds+assists total across that day's completed games (see
// daily-stat-leader-tracking capability). Only written once every game on
// that date has reached FINAL (see design.md "Full-slate check for daily
// leaders"), so a date is simply absent here until then.
model DailyStatLeader {
  id      Int      @id @default(autoincrement())
  date    DateTime @unique

  entries DailyStatLeaderEntry[]

  @@map("daily_stat_leader")
}

// One row per player tied for a given date's lead — a plain join table
// rather than a single playerId column so ties are represented structurally
// instead of needing an arbitrary tiebreak.
model DailyStatLeaderEntry {
  id                    Int             @id @default(autoincrement())
  dailyStatLeaderId     Int             @map("daily_stat_leader_id")
  dailyStatLeader       DailyStatLeader @relation(fields: [dailyStatLeaderId], references: [id])
  playerId              Int             @map("player_id")
  player                Player          @relation(fields: [playerId], references: [id])
  pointsReboundsAssists Int             @map("points_rebounds_assists")
  hadTripleDouble       Boolean         @default(false) @map("had_triple_double")

  @@unique([dailyStatLeaderId, playerId])
  @@map("daily_stat_leader_entry")
}

// ---------- Season aggregates ----------

model TeamSeasonStat {
  id               Int     @id @default(autoincrement())
  teamId           Int     @map("team_id")
  team             Team    @relation(fields: [teamId], references: [id])
  seasonId         Int     @map("season_id")
  season           Season  @relation(fields: [seasonId], references: [id])
  wins             Int?
  losses           Int?
  pointsPerGame    Float?  @map("points_per_game")
  oppPointsPerGame Float?  @map("opp_points_per_game")
  extra            String? // JSON-encoded; SQLite has no native Json type via this provider version

  @@unique([teamId, seasonId])
  @@map("team_season_stat")
}

// Season-to-date against-the-spread and over/under record per team,
// derived from `Odds` (the line in effect at tip-off) and each game's final
// score (see team-cover-record-tracking capability). Flat counters, not a
// per-game log — the page only ever needs the aggregate and the current
// streak. `atsCurrentStreak`/`ouCurrentStreak` are signed: positive counts
// a current covering/over streak, negative a current non-covering/under
// streak, 0 means no graded games yet.
model TeamCoverRecord {
  id       Int    @id @default(autoincrement())
  teamId   Int    @map("team_id")
  team     Team   @relation(fields: [teamId], references: [id])
  seasonId Int    @map("season_id")
  season   Season @relation(fields: [seasonId], references: [id])

  atsWins         Int @default(0) @map("ats_wins")
  atsLosses       Int @default(0) @map("ats_losses")
  atsPushes       Int @default(0) @map("ats_pushes")
  atsHomeWins     Int @default(0) @map("ats_home_wins")
  atsHomeLosses   Int @default(0) @map("ats_home_losses")
  atsHomePushes   Int @default(0) @map("ats_home_pushes")
  atsAwayWins     Int @default(0) @map("ats_away_wins")
  atsAwayLosses   Int @default(0) @map("ats_away_losses")
  atsAwayPushes   Int @default(0) @map("ats_away_pushes")
  atsCurrentStreak Int @default(0) @map("ats_current_streak")

  ouWins          Int @default(0) @map("ou_wins")
  ouLosses        Int @default(0) @map("ou_losses")
  ouPushes        Int @default(0) @map("ou_pushes")
  ouHomeWins      Int @default(0) @map("ou_home_wins")
  ouHomeLosses    Int @default(0) @map("ou_home_losses")
  ouHomePushes    Int @default(0) @map("ou_home_pushes")
  ouAwayWins      Int @default(0) @map("ou_away_wins")
  ouAwayLosses    Int @default(0) @map("ou_away_losses")
  ouAwayPushes    Int @default(0) @map("ou_away_pushes")
  ouCurrentStreak Int @default(0) @map("ou_current_streak")

  // Straight-up and ATS splits by market role (favorite vs. underdog per
  // ESPN's own `favorite` flag on the odds entry, not inferred from the
  // spread's sign) — only counted when a game actually has a recorded
  // favorite; a pick'em (no favorite) contributes to neither split.
  favWins       Int @default(0) @map("fav_wins")
  favLosses     Int @default(0) @map("fav_losses")
  dogWins       Int @default(0) @map("dog_wins")
  dogLosses     Int @default(0) @map("dog_losses")
  favAtsWins    Int @default(0) @map("fav_ats_wins")
  favAtsLosses  Int @default(0) @map("fav_ats_losses")
  favAtsPushes  Int @default(0) @map("fav_ats_pushes")
  dogAtsWins    Int @default(0) @map("dog_ats_wins")
  dogAtsLosses  Int @default(0) @map("dog_ats_losses")
  dogAtsPushes  Int @default(0) @map("dog_ats_pushes")

  @@unique([teamId, seasonId])
  @@map("team_cover_record")
}

// How a team's result compared with the closing spread, bucketed from
// `TeamGamePerformance.coverMargin` (see team-game-performance-tracking).
// Independent of whether the team won or lost the game.
enum PerformanceLabel {
  STRONG_OVER
  OVER
  AS_EXPECTED
  UNDER
  STRONG_UNDER
}

// Deterministic reason tags attached to a game's performance row.
enum PerformanceTag {
  STAR_OUT
  EARLY_BLOWOUT
  LATE_COLLAPSE
  GARBAGE_TIME_SWING
  SHOOTING_HOT
  SHOOTING_COLD
}

// One row per team per final game with a recorded spread: the team's
// expected margin (from the spread in effect at tip-off), its actual margin,
// and cover margin = actual - expected (see team-game-performance-tracking).
// Immutable once written — computed once by
// ingest/compute-team-game-performance.ts, so idempotency comes from the
// (gameId, teamId) unique constraint rather than a stamp on `Odds`.
model TeamGamePerformance {
  id             Int              @id @default(autoincrement())
  gameId         Int              @map("game_id")
  game           Game             @relation(fields: [gameId], references: [id])
  teamId         Int              @map("team_id")
  team           Team             @relation(fields: [teamId], references: [id])
  seasonId       Int              @map("season_id")
  season         Season           @relation(fields: [seasonId], references: [id])
  opponentTeamId Int              @map("opponent_team_id")
  isHome         Boolean          @map("is_home")
  // Derived from the spread's sign; null for a pick'em (spread 0).
  isFavorite     Boolean?         @map("is_favorite")
  // Team-relative line (favorite negative, e.g. -13.5), not home-relative.
  spread         Float
  expectedMargin Float            @map("expected_margin")
  actualMargin   Float            @map("actual_margin")
  coverMargin    Float            @map("cover_margin")
  label          PerformanceLabel
  computedAt     DateTime         @default(now()) @map("computed_at")

  tags TeamGamePerformanceTag[]

  @@unique([gameId, teamId])
  @@index([seasonId, teamId])
  @@map("team_game_performance")
}

model TeamGamePerformanceTag {
  id            Int                 @id @default(autoincrement())
  performanceId Int                 @map("performance_id")
  performance   TeamGamePerformance @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  tag           PerformanceTag

  @@unique([performanceId, tag])
  @@map("team_game_performance_tag")
}

model PlayerSeasonStat {
  id               Int     @id @default(autoincrement())
  playerId         Int     @map("player_id")
  player           Player  @relation(fields: [playerId], references: [id])
  teamId           Int     @map("team_id")
  team             Team    @relation(fields: [teamId], references: [id])
  seasonId         Int     @map("season_id")
  season           Season  @relation(fields: [seasonId], references: [id])
  gamesPlayed      Int?    @map("games_played")
  pointsPerGame    Float?  @map("points_per_game")
  reboundsPerGame  Float?  @map("rebounds_per_game")
  assistsPerGame   Float?  @map("assists_per_game")
  stealsPerGame    Float?  @map("steals_per_game")
  blocksPerGame    Float?  @map("blocks_per_game")
  turnoversPerGame Float?  @map("turnovers_per_game")
  fieldGoalPct     Float?  @map("field_goal_pct")
  threePointPct    Float?  @map("three_point_pct")
  freeThrowPct     Float?  @map("free_throw_pct")
  extra            String? // JSON-encoded

  @@unique([playerId, seasonId])
  @@map("player_season_stat")
}

model Standing {
  id             Int     @id @default(autoincrement())
  teamId         Int     @map("team_id")
  team           Team    @relation(fields: [teamId], references: [id])
  seasonId       Int     @map("season_id")
  season         Season  @relation(fields: [seasonId], references: [id])
  conferenceRank Int?    @map("conference_rank")
  divisionRank   Int?    @map("division_rank")
  wins           Int?
  losses         Int?
  winPct         Float?  @map("win_pct")
  gamesBehind    Float?  @map("games_behind")
  streak         String?
  homeRecord     String? @map("home_record")
  awayRecord     String? @map("away_record")
  divRecord      String? @map("div_record")
  confRecord     String? @map("conf_record")
  lastTen        String? @map("last_ten")
  threePtRecord  String? @map("three_pt_record")
  tenPtRecord    String? @map("ten_pt_record")
  vsOverRecord   String? @map("vs_over_record")
  vsUnderRecord  String? @map("vs_under_record")
  otRecord       String? @map("ot_record")
  vsEastRecord   String? @map("vs_east_record")
  vsAtlRecord    String? @map("vs_atl_record")
  vsCenRecord    String? @map("vs_cen_record")
  vsSeRecord     String? @map("vs_se_record")
  vsWestRecord   String? @map("vs_west_record")
  vsNwRecord     String? @map("vs_nw_record")
  vsPacRecord    String? @map("vs_pac_record")
  vsSwRecord     String? @map("vs_sw_record")

  @@unique([teamId, seasonId])
  @@map("standing")
}

// NBA Cup (In-Season Tournament) pool play, started 2023-24 (year 2024 in
// our convention) — a separate 6-pool grouping (3 per conference) unrelated
// to conference/division, sourced from ESPN's dedicated pool group ids
// (confirmed against the real core API: groups 22-27 are "East/West Group
// A/B/C", found by brute-forcing group ids — they aren't listed as children
// of the conference groups like divisions are).
model NbaCupStanding {
  id                Int     @id @default(autoincrement())
  teamId            Int     @map("team_id")
  team              Team    @relation(fields: [teamId], references: [id])
  seasonId          Int     @map("season_id")
  season            Season  @relation(fields: [seasonId], references: [id])
  groupName         String  @map("group_name")
  seed              Int?
  wins              Int?
  losses            Int?
  winPct            Float?  @map("win_pct")
  gamesBehind       Float?  @map("games_behind")
  homeRecord        String? @map("home_record")
  awayRecord        String? @map("away_record")
  pointsFor         Float?  @map("points_for")
  pointsAgainst     Float?  @map("points_against")
  pointDifferential Float?  @map("point_differential")
  streak            String?

  @@unique([teamId, seasonId])
  @@map("nba_cup_standing")
}

// ---------- News (stretch) ----------

model NewsArticle {
  id          Int       @id @default(autoincrement())
  espnId      String    @unique @map("espn_id")
  type        String?
  headline    String
  description String?
  url         String?
  imageUrl    String?   @map("image_url")
  publishedAt DateTime? @map("published_at")
  byline      String?
  story       String?

  teams   NewsArticleTeam[]
  players NewsArticlePlayer[]

  @@map("news_article")
}

model NewsArticleTeam {
  newsArticleId Int         @map("news_article_id")
  newsArticle   NewsArticle @relation(fields: [newsArticleId], references: [id])
  teamId        Int         @map("team_id")

  @@id([newsArticleId, teamId])
  @@map("news_article_team")
}

model NewsArticlePlayer {
  newsArticleId Int         @map("news_article_id")
  newsArticle   NewsArticle @relation(fields: [newsArticleId], references: [id])
  playerId      Int         @map("player_id")

  @@id([newsArticleId, playerId])
  @@map("news_article_player")
}
